# Copia este archivo a .env.local y coloca tu clave del NVD.
# .env.local está en .gitignore: nunca se sube al repositorio.
NVD_API_KEY=

# Opcionales, para subir el SBOM a Dependency-Track por API.
DEPENDENCY_TRACK_URL=http://localhost:8081
DEPENDENCY_TRACK_API_KEY=

# Opcionales, para importar el XML en DefectDojo por API.
DEFECTDOJO_URL=http://localhost:8080
DEFECTDOJO_API_KEY=
