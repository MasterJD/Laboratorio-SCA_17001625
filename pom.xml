<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.cysecurity</groupId>
  <artifactId>JavaVulnerableLab</artifactId>
  <packaging>war</packaging>
  <version>0.0.1-SNAPSHOT</version>
  <name>JavaVulnerableLab Maven Webapp</name>
  <url>http://maven.apache.org</url>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>
    <!-- Connector/J 8.4.0: corrige CVE-2023-22102 (afecta a <= 8.1.0).
         Mantiene el driver legacy com.mysql.jdbc.Driver que usa la app. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
    </dependency>
    <!-- protobuf-java es transitiva de Connector/J; 3.25.5 corrige
         CVE-2024-7254 (stack overflow al parsear grupos anidados). -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>3.25.5</version>
    </dependency>
    <dependency>
	    <groupId>org.json</groupId>
	    <artifactId>json</artifactId>
	    <version>20231013</version>
	</dependency>
	<dependency>
		<groupId>javax.servlet</groupId>
		<artifactId>jstl</artifactId>
		<version>1.2</version>
	</dependency>
	<!-- Hibernate 4.0.1 acumula CVEs sin parche en la rama 4.x; 5.6.15.Final
	     mantiene las APIs usadas por orm.jsp (Configuration, Session, Query)
	     y corrige CVE-2020-25638 y CVE-2019-14900. -->
	<dependency>
		<groupId>org.hibernate</groupId>
		<artifactId>hibernate-core</artifactId>
		<version>5.6.15.Final</version>
	</dependency>
	<!-- hibernate-core 4.x arrastraba dom4j 1.6.1 (CVE-2020-10683, CVSS 9.8).
	     Se fija 2.1.4 para que Maven resuelva esta versión corregida. -->
	<dependency>
		<groupId>org.dom4j</groupId>
		<artifactId>dom4j</artifactId>
		<version>2.1.4</version>
	</dependency>
	<dependency>
    <groupId>javax.servlet</groupId>
    <artifactId>servlet-api</artifactId>
    <version>2.3</version>
    <scope>provided</scope>
</dependency>
	<!-- JAXB was removed from the JDK in Java 11. JwtUtil uses
	     javax.xml.bind.DatatypeConverter, so the API is supplied explicitly to
	     keep the project buildable on the Java 17 JDK required by the lab. -->
	<dependency>
		<groupId>javax.xml.bind</groupId>
		<artifactId>jaxb-api</artifactId>
		<version>2.3.1</version>
	</dependency>
	<!-- OWASP 2025 A03 Software Supply Chain: se subió de log4j 2.12.1
	     (rama Java 7, vulnerable a Log4Shell CVE-2021-44228) a 2.26.1,
	     que corrige CVE-2021-44228, CVE-2021-45046, CVE-2021-45105,
	     CVE-2021-44832 y los CVE-2026 reportados sobre 2.25.x. -->
	<dependency>
		<groupId>org.apache.logging.log4j</groupId>
		<artifactId>log4j-api</artifactId>
		<version>2.26.1</version>
	</dependency>
	<dependency>
		<groupId>org.apache.logging.log4j</groupId>
		<artifactId>log4j-core</artifactId>
		<version>2.26.1</version>
	</dependency>
	<!-- OWASP 2025 A08 Software or Data Integrity Failures: commons-collections
	     3.1 (2004) carries the InvokerTransformer gadget used by ysoserial's
	     CommonsCollections chains. En esta rama se actualiza a 3.2.2, que
	     desactiva la deserialización de esos transformadores (CVE-2015-6420,
	     CVE-2015-7501). -->
	<dependency>
		<groupId>commons-collections</groupId>
		<artifactId>commons-collections</artifactId>
		<version>3.2.2</version>
	</dependency>
	<!-- OWASP 2025 A06 Insecure Design: file upload con validación de tipo
	     (CWE-434). Se actualiza a commons-fileupload 1.6.0 y commons-io
	     2.16.1, que corrigen CVE-2023-24998, CVE-2025-48976, CVE-2021-29425
	     y CVE-2024-47554. -->
	<dependency>
		<groupId>commons-fileupload</groupId>
		<artifactId>commons-fileupload</artifactId>
		<version>1.6.0</version>
	</dependency>
	<dependency>
		<groupId>commons-io</groupId>
		<artifactId>commons-io</artifactId>
		<version>2.16.1</version>
	</dependency>
  </dependencies>
  <build>
    <finalName>JavaVulnerableLab</finalName>
    <plugins>
      <!-- OWASP Dependency-Check: SCA local y en el pipeline de GitHub Actions.
           La clave del NVD se toma de la variable de entorno NVD_API_KEY para
           no escribirla nunca en el pom.xml ni en el workflow. -->
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>13.0.0</version>
        <configuration>
          <formats>
            <format>ALL</format>
          </formats>
          <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
          <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
          <!-- 11 = nunca falla por defecto; el pipeline lo baja a 7. -->
          <failBuildOnCVSS>${dependency-check.failBuildOnCVSS}</failBuildOnCVSS>
        </configuration>
      </plugin>
      <!-- CycloneDX: genera target/bom.json para Dependency-Track. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>2.9.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <projectType>application</projectType>
          <schemaVersion>1.5</schemaVersion>
          <outputFormat>json</outputFormat>
          <outputName>bom</outputName>
          <includeTestScope>false</includeTestScope>
        </configuration>
      </plugin>
    </plugins>
  </build>
    <properties>
        <maven.compiler.source>1.7</maven.compiler.source>
        <maven.compiler.target>1.7</maven.compiler.target>
        <dependency-check.failBuildOnCVSS>11</dependency-check.failBuildOnCVSS>
    </properties>
</project>
